{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "error-item-v1 serializer output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    },
    "errorLevel": {
      "type": "string",
      "enum": [
        "systemInfo",
        "warning",
        "severe",
        "danger"
      ]
    }
  },
  "required": [
    "title",
    "code",
    "description",
    "meta",
    "errorLevel"
  ]
}
